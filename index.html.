===================================================== */

async function calculateTrip(){

const os=
document.getElementById("originState").value;

const oc=
document.getElementById("originCity").value;

const ds=
document.getElementById("destinationState").value;

const dc=
document.getElementById("destinationCity").value;

const performance=
Number(
document.getElementById("performance").value
);

const fuelPrice=
Number(
document.getElementById("fuelPrice").value
);

const trip=
document.getElementById("trip").value;

if(!os||!oc||!ds||!dc){

alert(
"Selecciona el estado y ciudad de origen y destino."
);

return;

}

if(performance<=0||fuelPrice<=0){

alert(
"Revisa el precio del combustible y rendimiento."
);

return;

}


const origin=
oc+", "+os+", México";

const destination=
dc+", "+ds+", México";


const button=
document.querySelector(
"#viaticos .btn-primary"
);

button.disabled=true;

button.textContent=
"Calculando...";


try{

const distance=
await estimateDistance(
origin,
destination
);


const multiplier=
trip==="round"?2:1;


const totalKm=
distance*multiplier;


const liters=
totalKm/performance;


const fuelCost=
liters*fuelPrice;


/* CASETAS */

const tollData=
getTolls(oc,dc);


let tollCost=0;


if(tollData){

tollCost=
tollData.total*multiplier;

}


/* TOTAL */

const total=
fuelCost+tollCost;


/* RESULTADOS */

document
.getElementById("results")
.classList.add("show");


document
.getElementById("resultKm")
.textContent=
totalKm.toFixed(1)+" km";


document
.getElementById("resultFuel")
.textContent=
money(fuelCost);


document
.getElementById("resultTolls")
.textContent=
tollData
? money(tollCost)
: "Consultar";


document
.getElementById("resultTotal")
.textContent=
tollData
? money(total)
: money(fuelCost);


/* DESGLOSE */

document
.getElementById("breakFuel")
.textContent=
money(fuelCost);


document
.getElementById("breakTolls")
.textContent=
tollData
? money(tollCost)
: "Consultar SICT";


document
.getElementById("breakTotal")
.textContent=
tollData
? money(total)
: money(fuelCost);


/* TOTAL */

document
.getElementById("totalFuel")
.textContent=
money(fuelCost);


document
.getElementById("totalTolls")
.textContent=
tollData
? money(tollCost)
: "Consultar SICT";


document
.getElementById("grandTotal")
.textContent=
tollData
? money(total)
: money(fuelCost);


/* RESUMEN */

document
.getElementById("routeSummary")
.innerHTML=`

<p>
<strong>📍 Origen:</strong>
${origin}
</p>

<p>
<strong>🏁 Destino:</strong>
${destination}
</p>

<p>
<strong>📏 Distancia:</strong>
${totalKm.toFixed(1)} km
</p>

<p>
<strong>⛽ Litros estimados:</strong>
${liters.toFixed(2)} L
</p>

<p>
<strong>⛽ Combustible:</strong>
${money(fuelCost)}
</p>

<p>
<strong>🚧 Casetas:</strong>
${
tollData
? money(tollCost)
: "Consultar SICT"
}
</p>

<p>
<strong>💰 Total:</strong>
${
tollData
? money(total)
: money(fuelCost)+" + casetas"
}
</p>

`;


/* LISTA DE CASETAS */

renderTolls(
tollData,
multiplier
);

}
catch(error){

console.error(error);

alert(
"No fue posible calcular la distancia. "+
"Intenta nuevamente o revisa la ruta en Google Maps."
);

}

button.disabled=false;

button.textContent=
"💰 Calcular viáticos";

}


/* =====================================================
OBTENER CASETAS
===================================================== */

function getTolls(origin,destination){

let key=
origin+"|"+destination;

let reverse=
destination+"|"+origin;


if(rutasCasetas[key]){
return rutasCasetas[key];
}

if(rutasCasetas[reverse]){
return rutasCasetas[reverse];
}

return null;

}


/* =====================================================
MOSTRAR CASETAS
===================================================== */

function renderTolls(data,multiplier){

const container=
document.getElementById("tollList");


if(!data){

container.innerHTML=`

