: c[1]
}
</strong>

</div>

`).join("");


if(multiplier===2){

container.innerHTML+=`

<div
style="
margin-top:15px;
font-weight:bold;
color:#0f766e;
"
>
🔄 Los precios mostrados corresponden
a ida y vuelta.
</div>

`;

}

}


/* =====================================================
DISTANCIA
===================================================== */

async function estimateDistance(
origin,
destination
){

try{

const a=
await geocode(origin);

const b=
await geocode(destination);


const url=
"https://router.project-osrm.org/route/v1/driving/"+
a.lon+","+a.lat+";"+
b.lon+","+b.lat+
"?overview=false";


const response=
await fetch(url);


if(!response.ok){

throw new Error(
"No se pudo obtener la ruta"
);

}


const data=
await response.json();


if(
!data.routes ||
!data.routes.length
){

throw new Error(
"Ruta no encontrada"
);

}


return data.routes[0].distance/1000;

}
catch(error){

/* RUTAS DE RESPALDO */

const fallback={

"Guadalajara|Puerto Vallarta":295,

"Guadalajara|Tepic":200,

"Guadalajara|Ciudad de México":550,

"Guadalajara|Guanajuato":280,

"Ciudad de México|Puebla":135,

"Ciudad de México|Querétaro":220,

"Monterrey|Saltillo":90,

"Querétaro|Irapuato":170

};


const o=
origin.split(",")[0];

const d=
destination.split(",")[0];


const key=
o+"|"+d;

const reverse=
d+"|"+o;


if(fallback[key])
return fallback[key];

if(fallback[reverse])
return fallback[reverse];


throw error;

}

}


/* =====================================================
GEOCODIFICAR
===================================================== */

async function geocode(place){

const url=
"https://nominatim.openstreetmap.org/search"+
"?format=json"+
"&limit=1"+
"&countrycodes=mx"+
"&q="+
encodeURIComponent(place);


const response=
await fetch(url);


if(!response.ok){

throw new Error(
"No se pudo localizar la ciudad."
);

}


const data=
await response.json();


if(!data.length){

throw new Error(
"Ciudad no encontrada."
);

}


return{

lat:Number(data[0].lat),

lon:Number(data[0].lon)

};

}


